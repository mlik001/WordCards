    <!--
      图标语义：一张单词卡（三条释义线）+ 右下角绿色对勾（= 已掌握）。
      全部内容落在 108 的中心安全区（约 33~75）内，任何启动器遮罩都不会切掉主体。
    -->

    <!-- 卡片投影：用一层半透明黑模拟，避免自适应图标里无法使用 elevation -->
    <path
        android:fillColor="#1A000000"
        android:pathData="M39,39h30a6,6 0 0 1 6,6v22a6,6 0 0 1 -6,6h-30a6,6 0 0 1 -6,-6v-22a6,6 0 0 1 6,-6z" />

