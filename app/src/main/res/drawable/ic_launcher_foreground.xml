        android:fillColor="#FFFFFF"
        android:pathData="M39,36h30a6,6 0 0 1 6,6v22a6,6 0 0 1 -6,6h-30a6,6 0 0 1 -6,-6v-22a6,6 0 0 1 6,-6z" />

    <!-- 三条释义线：由长到短，暗示「条目列表」 -->
    <path
        android:pathData="M41,46.5H68"
        android:strokeColor="#4361EE"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M41,54H61"
        android:strokeColor="#4361EE"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M41,61.5H51"
        android:strokeColor="#4361EE"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- 掌握标记 -->
